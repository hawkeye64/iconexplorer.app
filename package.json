{
  "name": "iconexplorer.app",
  "version": "3.3.16",
  "private": true,
  "description": "Icon Explorer application for Quasar Framework SVG icons. 180k+ searchable icons and growing.",
  "author": "Jeff Galbraith <jeff@quasar.dev>",
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:icon-sets": "node scripts/generate-icon-sets.mjs",
    "typecheck": "pnpm generate:icon-sets && vue-tsc --noEmit --pretty false",
    "test": "echo \"No test specified\" && exit 0",
    "deep": "ncu --configFilePath . --packageFile package.json",
    "dev": "pnpm generate:icon-sets && quasar dev",
    "build": "pnpm generate:icon-sets && quasar build",
    "check:all": "pnpm verify",
    "verify": "pnpm verify:fast && pnpm verify:build",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm test",
    "verify:build": "pnpm build && pnpm typecheck",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "2.1.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "quasar-extras-svg-icons": "3.4.2",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@md-plugins/vite-ssg-plugin": "2.2.1",
    "@quasar/app-vite": "3.10.3",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "npm-check-updates": "^23.1.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "~6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.5.0"
  },
  "packageManager": "pnpm@12.16.1",
  "productName": "Icon Explorer for Quasar Framework SVG Icons"
}
